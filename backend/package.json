{
  "name": "citicious-backend",
  "version": "0.2.0",
  "description": "Backend API for Citicious - Retracted and fake citation detection",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/review-findings.test.mjs",
    "start": "node dist/app.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "import:retractions": "tsx src/scripts/import-retraction-watch.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.22.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "string-similarity-js": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
